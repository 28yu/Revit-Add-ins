#version 450
// ノイズ除去 その3: 仕上げ。ならした明るさに面の色を掛け戻し、画面に出す色にする。
// ローカルトーンマッピング: 「大まかな明るさ」（localexp_down / localexp_blur）が画面の平均から大きく離れた所だけ、
// 平均に近づける（屋根の下から見た外が白くとばないように）。平均の近くの明るさの差と、細かい模様の明暗はそのまま残す
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D uFiltered; // ならした明るさ
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D uHistory;  // （未使用。入出力の番号をそろえるため残す）
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D uAlbedo;  // 面の色（時間方向に平均したもの）
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D uOutput;    // 画面に出す色
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D uLocal;   // 大まかな明るさ（8×8 画素ごと。x = log2, y = 1 なら値あり）

layout(push_constant) uniform Params {
    float exposure;  // 明るさの倍率
    uint background; // 背景色（RGBA8。a が 0 以外なら、空の見えている所をこの色にする）
    uint transparent; // 1 = 背景を透明にする（PNG の書き出し用。不透明度 = 物が見えている割合）
    float pivot;     // 画面の平均の明るさ（log2）。ここを中心に縮める
    float strength;  // ローカルトーンマッピングの強さ（0 = 使わない、1 = 標準）
    float brightIn;  // 明るい所（画面の上位 5%）が平均から何段上か（前のフレームで測った値）
    float brightOut; // それを何段上に収めるか（brightIn 以下。同じなら明るい側は縮めない）
} pc;

// 平均からの差 x（段。0 以上）を縮める。start 段までは変えず、そこから先はなめらかに傾きを下げて、
// x = inMax のときに outMax になるようにする（y = start + d / (1 + a·d)、d = x − start）
float compressEv(float x, float start, float inMax, float outMax) {
    if (x <= start || inMax <= outMax + 1e-3) return x;
    float dIn = inMax - start, dOut = max(outMax - start, 1e-3);
    float a = (dIn / dOut - 1.0) / dIn;
    float d = x - start;
    return start + d / (1.0 + a * d);
}

// 画素の位置の「大まかな明るさ」。小さい画像の周り 4 画素を、距離と「この画素の明るさとの近さ」で重みを付けて混ぜる
// （明るさの境目をまたいで混ぜないので、柱の輪郭などに光のにじみが出にくい）
float localBase(ivec2 p, float pixelLog) {
    ivec2 smallSize = imageSize(uLocal);
    vec2 sp = (vec2(p) + 0.5) / 8.0 - 0.5;
    ivec2 b = ivec2(floor(sp));
    vec2 f = sp - vec2(b);
    float sum = 0.0, wSum = 0.0;
    for (int k = 0; k < 4; ++k) {
        ivec2 o = ivec2(k & 1, k >> 1);
        vec4 s = imageLoad(uLocal, clamp(b + o, ivec2(0), smallSize - 1));
        if (s.y <= 0.0) continue;
        float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y) + 1e-4;
        float d = s.x - pixelLog;
        w *= exp(-d * d / (2.0 * 1.5 * 1.5));
        sum += s.x * w;
        wSum += w;
    }
    return wSum > 0.0 ? sum / wSum : pixelLog;
}

// ACES に近いトーンマッピング（明るい所を白飛びさせずに表示する）
vec3 tonemap(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}


void main() {
    ivec2 size = imageSize(uFiltered);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    // ならす強さは atrous の中で「残っているノイズの大きさ」に合わせて自動で弱まるので、ここではそのまま使う
    vec4 albedoCov = imageLoad(uAlbedo, p);
    vec3 color = imageLoad(uFiltered, p).rgb * albedoCov.rgb;
    if (pc.strength > 0.0) {
        float pixelLog = log2(max(dot(color, vec3(0.2126, 0.7152, 0.0722)), 1e-5));
        float x = localBase(p, clamp(pixelLog, -16.0, 16.0)) - pc.pivot;
        // 明るい側: 平均より 0.5 段上から縮め、画面の上位 5% の明るさが brightOut 段上に来るようにする。
        // 暗い側: 平均より 3 段以上暗い所だけ少し持ち上げる（3 段より先は傾き 0.6）
        float y = x >= 0.0 ? compressEv(x, 0.5, pc.brightIn, pc.brightOut)
                           : -(-x <= 3.0 ? -x : 3.0 + (-x - 3.0) * 0.6);
        color *= exp2((y - x) * pc.strength);
    }
    // 透明にするときは、輪郭の画素が背景の分だけ暗くならないよう、物の割合で割り戻す
    if (pc.transparent != 0u) color /= max(albedoCov.a, 0.05);
    // 仕上げの色味: 少し暖かく（日なたの白が青白くならないように）、彩度をわずかに抑える（Enscape に近い落ち着いた色）
    vec3 graded = color * vec3(1.06, 1.0, 0.92);
    float gl = dot(graded, vec3(0.2126, 0.7152, 0.0722));
    graded = mix(vec3(gl), graded, 0.9);
    vec3 mapped = pow(tonemap(graded * pc.exposure), vec3(1.0 / 2.2));
    float coverage = 1.0;
    if ((pc.background >> 24u) != 0u) {
        // 背景色は明るさの調整を受けない（選んだ色のまま出す）
        vec3 bg = vec3(float(pc.background & 255u), float((pc.background >> 8u) & 255u),
                       float((pc.background >> 16u) & 255u)) / 255.0;
        coverage = clamp(albedoCov.a, 0.0, 1.0);
        mapped = mix(bg, mapped, coverage);
    }
    if (pc.transparent != 0u) {
        float a = clamp(albedoCov.a, 0.0, 1.0);
        imageStore(uOutput, p, vec4(pow(tonemap(graded * pc.exposure), vec3(1.0 / 2.2)), a));
    } else {
        imageStore(uOutput, p, vec4(mapped, 1.0));
    }
}
