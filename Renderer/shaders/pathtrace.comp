#version 460
// 1ピクセルずつ「光の通り道」を追いかけて色を決める（パストレーシング）。
// 光線と形の当たり判定は GPU の光の計算専用回路（レイトレーシング）が行う（GL_EXT_ray_query）。
// 毎フレーム 1 回ずつ計算し、カメラが止まっている間は結果を足し合わせて画質を上げていく。
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

// 形の当たり判定用データ。インスタンス 0 = 不透明な物、1 = ガラス
layout(set = 0, binding = 0) uniform accelerationStructureEXT uScene;
layout(set = 0, binding = 1, rgba32f) uniform image2D uAccum;   // 足し合わせ中の明るさ（物理量のまま）
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uOutput; // 画面に出す色

struct Vertex { vec4 position; vec4 normal; };
layout(set = 0, binding = 3, std430) readonly buffer Vertices { Vertex vertices[]; };
layout(set = 0, binding = 4, std430) readonly buffer Indices { uint indices[]; };
// 三角形ごとのマテリアル番号。ガラスの三角形はガラス用の並びに入っている
layout(set = 0, binding = 5, std430) readonly buffer TriMaterials { uint triMaterials[]; };

struct Material {
    vec4 color;   // rgb = 色（リニア）、a = 不透明度
    vec4 params;  // x = 粗さ, y = 金属らしさ, z = 自己発光の強さ, w = 未使用
};
layout(set = 0, binding = 6, std430) readonly buffer Materials { Material materials[]; };

// 自動露出用: 画面の明るさの対数の合計（間引いた画素だけ）
layout(set = 0, binding = 7, std430) buffer Exposure { int logLumSum; int logLumCount; };

layout(push_constant) uniform Params {
    vec4 camPos;      // xyz = 位置, w = 縦の画角の tan(半分)
    vec4 camForward;  // xyz = 前, w = パノラマなら 1
    vec4 camRight;    // xyz = 右, w = 横の倍率（縦横比）
    vec4 camUp;       // xyz = 上
    vec4 sunDir;      // xyz = 太陽のある方向, w = 太陽の明るさ
    vec4 misc;        // x = 露出の倍率, y = 空の明るさ, z = ガラス三角形の開始位置（三角形番号）, w = 未使用
    uvec4 frame;      // x = フレーム番号, y = 足し合わせ済みの回数, z = 最大反射回数
} pc;

const float PI = 3.14159265359;
const uint MASK_OPAQUE = 0x01u;
const uint MASK_GLASS = 0x02u;

// --- 乱数（PCG） ---------------------------------------------------------
uint rngState;
uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float rand() { rngState = pcg(rngState); return float(rngState) / 4294967296.0; }

// --- 空 -----------------------------------------------------------------
// 簡単な空のモデル（天頂は青く、地平線は白っぽく、太陽の周りは明るい）。
vec3 skyRadiance(vec3 dir) {
    vec3 sun = normalize(pc.sunDir.xyz);
    float up = dir.z;
    if (up < 0.0) {
        // 地平線より下: 太陽と空に照らされた地面の明るさ（地面の色 × 地面に届く光 ÷ π）
        vec3 groundAlbedo = vec3(0.3, 0.29, 0.27);
        float irradiance = pc.sunDir.w * max(sun.z, 0.0) + PI * 0.6 * pc.misc.y;
        return groundAlbedo * irradiance / PI;
    }
    vec3 zenith = vec3(0.25, 0.45, 0.95);
    vec3 horizon = vec3(0.85, 0.9, 1.0);
    float t = pow(1.0 - up, 4.0);
    vec3 sky = mix(zenith, horizon, t);
    float cosSun = max(dot(dir, sun), 0.0);
    sky += vec3(1.0, 0.9, 0.7) * pow(cosSun, 8.0) * 0.6;   // 太陽の周りの明るさ
    float sunHeight = clamp(sun.z * 4.0, 0.0, 1.0);
    return sky * pc.misc.y * (0.2 + 0.8 * sunHeight);
}

// 太陽そのもの（見える円盤）。直接光はシャドウレイで別に計算するので、カメラから直接見たときだけ使う
vec3 sunDisc(vec3 dir) {
    float cosSun = dot(dir, normalize(pc.sunDir.xyz));
    return cosSun > 0.99996 ? vec3(1.0, 0.95, 0.85) * pc.sunDir.w * 2000.0 : vec3(0.0);
}

// --- 当たり判定 ---------------------------------------------------------
struct Hit {
    bool found;
    float t;
    uint tri;       // 全体での三角形番号
    vec2 bary;
    bool glass;
};

Hit traceClosest(vec3 origin, vec3 dir, uint mask) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uScene, gl_RayFlagsOpaqueEXT, mask, origin, 0.0005, dir, 1e6);
    while (rayQueryProceedEXT(rq)) {}
    Hit h;
    h.found = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    if (h.found) {
        h.t = rayQueryGetIntersectionTEXT(rq, true);
        uint instance = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
        h.glass = instance == 1u;
        h.tri = h.glass ? prim + uint(pc.misc.z) : prim;
        h.bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    }
    return h;
}

// 影の判定。ガラスは光を通すので不透明な物だけを見る
bool occluded(vec3 origin, vec3 dir) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uScene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          MASK_OPAQUE, origin, 0.0005, dir, 1e6);
    while (rayQueryProceedEXT(rq)) {}
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void surfaceAt(Hit h, vec3 rayDir, out vec3 pos, out vec3 normal, out vec3 geomNormal) {
    uint i0 = indices[h.tri * 3u], i1 = indices[h.tri * 3u + 1u], i2 = indices[h.tri * 3u + 2u];
    vec3 p0 = vertices[i0].position.xyz, p1 = vertices[i1].position.xyz, p2 = vertices[i2].position.xyz;
    float b0 = 1.0 - h.bary.x - h.bary.y;
    pos = p0 * b0 + p1 * h.bary.x + p2 * h.bary.y;
    geomNormal = normalize(cross(p1 - p0, p2 - p0));
    vec3 n = vertices[i0].normal.xyz * b0 + vertices[i1].normal.xyz * h.bary.x + vertices[i2].normal.xyz * h.bary.y;
    normal = dot(n, n) > 1e-8 ? normalize(n) : geomNormal;
    // 裏から当たったときは表向きにそろえる（Revit の形は裏表が混ざっていることがある）
    if (dot(geomNormal, rayDir) > 0.0) geomNormal = -geomNormal;
    if (dot(normal, geomNormal) < 0.0) normal = -normal;
}

// --- 反射の向きを選ぶ ---------------------------------------------------
void basis(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

vec3 cosineHemisphere(vec3 n) {
    float r1 = rand(), r2 = rand();
    float r = sqrt(r1), phi = 2.0 * PI * r2;
    vec3 t, b;
    basis(n, t, b);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - r1)));
}

// GGX（つやのある面の反射）の向きを選ぶ
vec3 ggxReflect(vec3 v, vec3 n, float roughness) {
    float a = max(roughness * roughness, 0.001);
    float r1 = rand(), r2 = rand();
    float phi = 2.0 * PI * r1;
    float cosTheta = sqrt((1.0 - r2) / (1.0 + (a * a - 1.0) * r2));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 t, b;
    basis(n, t, b);
    vec3 h = normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + n * cosTheta);
    return reflect(v, h);
}

float fresnelSchlick(float cosTheta, float f0) {
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

// --- 1本の光の通り道を追う -----------------------------------------------
vec3 radiance(vec3 origin, vec3 dir) {
    vec3 result = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 sun = normalize(pc.sunDir.xyz);
    vec3 sunColor = vec3(1.0, 0.95, 0.88) * pc.sunDir.w;
    bool specularPath = true;  // カメラから鏡のような反射だけで来た（太陽の円盤を見せてよい）

    for (uint bounce = 0u; bounce <= pc.frame.z; ++bounce) {
        Hit h = traceClosest(origin, dir, MASK_OPAQUE | MASK_GLASS);
        if (!h.found) {
            result += throughput * (skyRadiance(dir) + (specularPath ? sunDisc(dir) : vec3(0.0)));
            break;
        }
        vec3 pos, n, gn;
        surfaceAt(h, dir, pos, n, gn);
        Material m = materials[triMaterials[h.tri]];
        vec3 albedo = m.color.rgb;
        float roughness = clamp(m.params.x, 0.02, 1.0);
        float metallic = m.params.y;
        result += throughput * albedo * m.params.z;  // 自己発光（照明器具など）

        if (h.glass) {
            // 薄いガラスとして扱う: 表面で反射するか、そのまま通り抜けるか
            float f = fresnelSchlick(abs(dot(-dir, n)), 0.04);
            if (rand() < f) {
                dir = reflect(dir, gn);
            } else {
                throughput *= mix(vec3(1.0), albedo, 0.3);  // ガラスのわずかな色
            }
            origin = pos + dir * 0.001;
            continue;
        }

        vec3 v = dir;
        float cosV = max(dot(-v, n), 0.0);
        // 金属は色付きの反射だけ、金属でない物は「反射（白）」か「拡散（物の色）」を確率で選ぶ
        float specProb = metallic > 0.5 ? 1.0 : fresnelSchlick(cosV, 0.04) * (1.0 - roughness * 0.7) + 0.04;
        specProb = clamp(specProb, 0.0, 1.0);

        // 太陽の直接光（拡散面のみ。影の判定は専用回路で行う）
        float nDotL = dot(n, sun);
        if (nDotL > 0.0 && sun.z > -0.05 && metallic <= 0.5) {
            if (!occluded(pos + gn * 0.002, sun)) {
                result += throughput * (1.0 - specProb) * albedo * sunColor * nDotL;  // 拡散面の明るさ = 色 × 光の強さ × 光の当たる角度
            }
        }

        if (rand() < specProb) {
            vec3 newDir = ggxReflect(v, n, roughness);
            if (dot(newDir, gn) <= 0.0) break;
            throughput *= metallic > 0.5 ? albedo : vec3(1.0);
            dir = newDir;
            // ほぼ鏡のときだけ太陽の円盤を映す（ざらついた面では直接光として計算済み）
            specularPath = specularPath && roughness < 0.1;
        } else {
            dir = cosineHemisphere(n);
            throughput *= albedo;
            specularPath = false;
        }
        origin = pos + gn * 0.002;

        // 光がほとんど残っていなければ打ち切る
        float p = max(throughput.r, max(throughput.g, throughput.b));
        if (bounce >= 2u) {
            if (rand() > p) break;
            throughput /= p;
        }
    }
    return result;
}

// ACES に近いトーンマッピング（明るい所を白飛びさせずに表示する）
vec3 tonemap(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 size = imageSize(uAccum);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    rngState = pcg(uint(pixel.x) + uint(pixel.y) * 9781u + pc.frame.x * 6271u * 26699u);

    // ピクセル内の位置を毎回少しずらして、ぎざぎざを消す
    vec2 jitter = pc.frame.y == 0u ? vec2(0.5) : vec2(rand(), rand());
    vec2 uv = (vec2(pixel) + jitter) / vec2(size);
    vec3 dir;
    if (pc.camForward.w > 0.5) {
        // 360°パノラマ（正距円筒図法）: 横 = 方位 -180°〜180°、縦 = 上 90°〜下 -90°
        float lon = (uv.x - 0.5) * 2.0 * PI;
        float lat = (0.5 - uv.y) * PI;
        vec3 f = pc.camForward.xyz, r = pc.camRight.xyz, u = pc.camUp.xyz;
        dir = normalize(cos(lat) * (cos(lon) * f + sin(lon) * r) + sin(lat) * u);
    } else {
        vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
        float th = pc.camPos.w;
        dir = normalize(pc.camForward.xyz + pc.camRight.xyz * ndc.x * th * pc.camRight.w + pc.camUp.xyz * ndc.y * th);
    }

    vec3 color = radiance(pc.camPos.xyz, dir);
    // 極端に明るい点（ホタル）を抑える
    float lum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    if (lum > 50.0) color *= 50.0 / lum;

    vec3 accum = color;
    if (pc.frame.y > 0u) accum += imageLoad(uAccum, pixel).rgb;
    imageStore(uAccum, pixel, vec4(accum, 1.0));

    vec3 avg = accum / float(pc.frame.y + 1u);
    vec3 mapped = tonemap(avg * pc.misc.x);
    imageStore(uOutput, pixel, vec4(pow(mapped, vec3(1.0 / 2.2)), 1.0));

    // 自動露出用に 4×4 ピクセルに 1 つだけ明るさを集計する
    if ((pixel.x & 3) == 0 && (pixel.y & 3) == 0) {
        float l = dot(avg, vec3(0.2126, 0.7152, 0.0722));
        int q = int(clamp(log2(max(l, 1e-5)), -16.0, 16.0) * 256.0);
        atomicAdd(logLumSum, q);
        atomicAdd(logLumCount, 1);
    }
}
