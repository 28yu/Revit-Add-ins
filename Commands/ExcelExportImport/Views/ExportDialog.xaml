<Window x:Class="Tools28.Commands.ExcelExportImport.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXCELエクスポート"
        Width="750"
        Height="520"
        MinWidth="650"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- カラー定義 -->
        <SolidColorBrush x:Key="RevitBlue" Color="#0066CC"/>
        <SolidColorBrush x:Key="RevitHoverBlue" Color="#0052A3"/>
        <SolidColorBrush x:Key="RevitDarkGray" Color="#333333"/>
        <SolidColorBrush x:Key="RevitLightGray" Color="#E6E6E6"/>

        <!-- ボタンスタイル -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource RevitBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource RevitBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RevitHoverBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RevitHoverBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 移動ボタンスタイル -->
        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 全選択/選択解除など小さめのリンク風ボタン -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 検索ボックススタイル -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- カテゴリグループの折りたたみ用 Expander スタイル（▼/▶ でパラメータを開閉） -->
        <Style x:Key="CategoryGroupExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Cursor="Hand" HorizontalAlignment="Left"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2,5,4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="▼" FontSize="9"
                                                           Foreground="#0066CC" VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メインエリア: カテゴリ | パラメータ | ＞＜ | 出力 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左カラム: カテゴリを選択 -->
            <GroupBox x:Name="grpCategory" Grid.Column="0" Header="カテゴリを選択" Margin="0,0,4,0" FontSize="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CategorySearchBox" Grid.Column="0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="CategorySearchBox_TextChanged"/>
                        <Button x:Name="btnSearchCat" Grid.Column="1" Content="検索" Width="40" Height="24" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CategorySearchButton_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnCatSelectAll" Content="全選択"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="CategorySelectAllButton_Click"/>
                        <Button x:Name="btnCatSelectNone" Content="選択解除"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="CategorySelectNoneButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="CategoryListBox" Grid.Row="2"
                             BorderThickness="1" BorderBrush="#CCCCCC"
                             SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}"
                                          Checked="CategoryCheckBox_Changed"
                                          Unchecked="CategoryCheckBox_Changed"
                                          FontSize="11" Margin="2,1">
                                    <TextBlock Text="{Binding DisplayLabel}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- 中央カラム: パラメータ -->
            <GroupBox x:Name="grpParameter" Grid.Column="1" Header="パラメータ" Margin="4,0,4,0" FontSize="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParameterSearchBox" Grid.Column="0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="ParameterSearchBox_TextChanged"/>
                        <Button x:Name="btnSearchParam" Grid.Column="1" Content="検索" Width="40" Height="24" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ParameterSearchButton_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnParamSelectAll" Content="全選択"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="ParameterSelectAllButton_Click"/>
                        <Button x:Name="btnParamSelectNone" Content="選択解除"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="ParameterSelectNoneButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ParameterListBox" Grid.Row="2"
                             BorderThickness="1" BorderBrush="#CCCCCC"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander Style="{StaticResource CategoryGroupExpanderStyle}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       FontSize="11" Foreground="#0066CC"/>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="14,0,0,0"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}"
                                          FontSize="11" Margin="2,1">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- パラメータ⇔出力の追加/削除ボタン -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0">
                <Button x:Name="btnAddToOutput" Content="＞" ToolTip="出力に追加"
                        Style="{StaticResource MoveButtonStyle}"
                        Click="AddToOutputButton_Click" Margin="0,2"/>
                <Button x:Name="btnRemoveFromOutput" Content="＜" ToolTip="出力から削除"
                        Style="{StaticResource MoveButtonStyle}"
                        Click="RemoveFromOutputButton_Click" Margin="0,2"/>
            </StackPanel>

            <!-- 右カラム: 出力 -->
            <GroupBox x:Name="grpOutput" Grid.Column="3" Header="出力" Margin="4,0,0,0" FontSize="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputSearchBox" Grid.Column="0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="OutputSearchBox_TextChanged"/>
                        <Button x:Name="btnSearchOutput" Grid.Column="1" Content="検索" Width="40" Height="24" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OutputSearchButton_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnClearOutput" Content="クリア" MinWidth="0" Padding="5,0"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="ClearOutputButton_Click"/>
                        <Button x:Name="btnLoadSettings" Content="読込" MinWidth="0" Padding="5,0"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="LoadSettingsButton_Click"/>
                        <Button x:Name="btnLoadSettingsFromExcel" Content="Excel" MinWidth="0" Padding="5,0"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="LoadSettingsFromExcelButton_Click"/>
                        <Button x:Name="btnSaveSettings" Content="保存" MinWidth="0" Padding="5,0"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="SaveSettingsButton_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="SplitByCategoryCheckBox" Grid.Row="2"
                              IsChecked="True" Margin="0,0,0,4" VerticalContentAlignment="Center">
                        <TextBlock x:Name="SplitByCategoryLabel"
                                   Text="出力Excelをカテゴリ毎にシートに分ける"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </CheckBox>
                    <ListBox x:Name="OutputListBox" Grid.Row="3"
                             BorderThickness="1" BorderBrush="#CCCCCC"
                             SelectionMode="Single"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   FontSize="11" Margin="4,6,4,2"
                                                   Foreground="#0066CC"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ▲▼ 順序変更ボタン（出力セクションの中心） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- パラメータ プレフィックス凡例（I- / T-） -->
            <TextBlock x:Name="ParamPrefixLegend" Grid.Column="1" Margin="4,6,4,0"
                       Text="I- : インスタンス（要素）パラメータ&#x0a;T- : タイプパラメータ"
                       FontSize="10" Foreground="#555555" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,6,0,0">
                <Button x:Name="btnMoveUp" Content="▲" ToolTip="上へ移動"
                        Style="{StaticResource MoveButtonStyle}"
                        Click="MoveUpButton_Click"/>
                <Button x:Name="btnMoveDown" Content="▼" ToolTip="下へ移動"
                        Style="{StaticResource MoveButtonStyle}"
                        Click="MoveDownButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 下部ボタンエリア（OK/キャンセルのみ） -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOK" Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OkButton_Click"/>
                <Button x:Name="btnCancel" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
