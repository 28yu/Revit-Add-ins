<Window x:Class="Tools28.Commands.ExcelExportImport.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXCELインポート"
        Width="820"
        Height="500"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="RevitBlue" Color="#0066CC"/>
        <SolidColorBrush x:Key="RevitHoverBlue" Color="#0052A3"/>
        <SolidColorBrush x:Key="RevitDarkGray" Color="#333333"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource RevitBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource RevitBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RevitHoverBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RevitHoverBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ファイル選択 -->
        <GroupBox x:Name="grpExcelFile" Grid.Row="0" Header="Excelファイル" FontSize="12" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathTextBox" Grid.Column="0"
                         IsReadOnly="True" FontSize="11" Padding="4,2"
                         BorderBrush="#CCCCCC"/>
                <Button x:Name="btnOpenFiles" Grid.Column="1" Content="開いているファイル"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="4,0,0,0"
                        Click="OpenFilesButton_Click"/>
                <Button x:Name="btnBrowse" Grid.Column="2" Content="参照..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="4,0,0,0"
                        Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- プレビュー -->
        <GroupBox x:Name="grpPreview" Grid.Row="1" Header="変更プレビュー" FontSize="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 取り込む行の一括選択・絞り込み解除 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                    <Button x:Name="btnSelectAllVisible" Content="表示中を全選択"
                            Style="{StaticResource SecondaryButtonStyle}" Height="24" Margin="0,0,4,0"
                            Click="SelectAllVisible_Click"/>
                    <Button x:Name="btnDeselectAllVisible" Content="表示中を選択解除"
                            Style="{StaticResource SecondaryButtonStyle}" Height="24" Margin="0,0,4,0"
                            Click="DeselectAllVisible_Click"/>
                    <Button x:Name="btnClearFilters" Content="絞り込みを解除"
                            Style="{StaticResource SecondaryButtonStyle}" Height="24" Margin="0,0,4,0"
                            Click="ClearFilters_Click"/>
                    <TextBlock x:Name="txtFilterHint" Text="列見出しの ▾ で並べ替え・絞り込み"
                               FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <DataGrid x:Name="PreviewDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          FontSize="11"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F9F9F9"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="colSelect" Header="取込" Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="colElementId" Header="要素ID" Binding="{Binding ElementId}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="colCategory" Header="カテゴリ" Binding="{Binding CategoryName}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="colParameter" Header="パラメータ" Binding="{Binding ParameterName}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="colCurrentValue" Header="現在値" Binding="{Binding CurrentValue}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="colNewValue" Header="新しい値" Binding="{Binding NewValue}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- サマリー -->
        <TextBlock x:Name="SummaryText" Grid.Row="2" FontSize="11"
                   Margin="4,8,4,4" Foreground="#666666"/>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="ImportButton" Content="インポート実行"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"
                    Click="ImportButton_Click"/>
            <Button x:Name="btnCancel" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
