<Window x:Class="Tools28.Commands.ExcelExportImport.Views.ExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXCELエクスポート"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="16,14,16,14">
        <TextBlock x:Name="CategoryText" FontSize="12" Foreground="#222222"
                   TextTrimming="CharacterEllipsis" Text=" "/>
        <ProgressBar x:Name="ElementProgress" Height="16" Margin="0,8,0,4"
                     Minimum="0" Maximum="1" Value="0"/>
        <Grid>
            <TextBlock x:Name="ElementText" FontSize="11" Foreground="#555555"
                       HorizontalAlignment="Left" Text=" "/>
            <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="#555555"
                       HorizontalAlignment="Right" Text=" "/>
        </Grid>
        <TextBlock x:Name="SlowestText" FontSize="11" Foreground="#B05A00"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Button x:Name="btnCancel" Content="キャンセル" HorizontalAlignment="Right"
                MinWidth="90" Height="26" Margin="0,12,0,0" Padding="10,0"
                Click="CancelButton_Click"/>
    </StackPanel>
</Window>
