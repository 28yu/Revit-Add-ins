<Window x:Class="Tools28.Commands.DwgLayerTransfer.Views.DwgLayerTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWGレイヤ表示設定の移行"
        Width="1040"
        Height="740"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="RevitBlue" Color="#0066CC"/>
        <SolidColorBrush x:Key="RevitHoverBlue" Color="#0052A3"/>
        <SolidColorBrush x:Key="RevitDarkGray" Color="#333333"/>

        <!-- 移行元＝淡いティール系 / 移行先＝淡いアンバー系。
             左右をひと目で区別できるよう、あえて色相の離れた淡色を割り当てている -->
        <SolidColorBrush x:Key="SourceTint"   Color="#E6F2F1"/>
        <SolidColorBrush x:Key="SourceAccent" Color="#1F6E68"/>
        <SolidColorBrush x:Key="SourceLine"   Color="#BFDCD9"/>
        <SolidColorBrush x:Key="TargetTint"   Color="#FBF0DE"/>
        <SolidColorBrush x:Key="TargetAccent" Color="#8A5A12"/>
        <SolidColorBrush x:Key="TargetLine"   Color="#EBD8B6"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource RevitBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource RevitBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RevitHoverBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RevitHoverBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- セクション見出し（文字色は移行元/移行先それぞれで指定する） -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- 補足の注記 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- リスト内の小見出し -->
        <Style x:Key="ListCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- DWG 一覧の行（名前＋種別＋詳細） -->
        <DataTemplate x:Key="DwgItemTemplate">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#888888"
                               Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DetailText}" FontSize="10"
                           Foreground="#5F7A8A" Margin="8,1,2,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 反映先 DWG の行（チェックボックス付き。複数の DWG へまとめて反映できる） -->
        <DataTemplate x:Key="DwgCheckItemTemplate">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#888888"
                               Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DetailText}" FontSize="10"
                           Foreground="#5F7A8A" Margin="8,1,2,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 説明 -->
        <TextBlock x:Name="txtDescription" Grid.Row="0"
                   Text="開いている別のモデルから、DWG レイヤの表示設定をこのモデルへ移行します。"
                   TextWrapping="Wrap" FontSize="12" Foreground="#333333" Margin="0,0,0,8"/>

        <!-- ===== 上部: 移行元モデル・移行先モデル・移行の単位 ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="2" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblSource" Grid.Row="0" Grid.Column="0" Text="移行元モデル:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                <ComboBox x:Name="cmbSource" Grid.Row="0" Grid.Column="1" Height="26" FontSize="12"
                          VerticalContentAlignment="Center" Margin="0,0,0,4"
                          SelectionChanged="Source_Changed"/>

                <TextBlock x:Name="lblTarget" Grid.Row="1" Grid.Column="0" Text="移行先モデル:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                <TextBlock x:Name="txtTarget" Grid.Row="1" Grid.Column="1" Text=""
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TargetAccent}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                <!-- 単位の選択は「反映先」だけに効く。移行元は常にビュー単位で読み取る -->
                <TextBlock x:Name="lblMode" Grid.Row="2" Grid.Column="0" Text="反映先の単位:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,4,8,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="rbView" Content="ビュー" GroupName="Mode" IsChecked="True"
                                 VerticalAlignment="Center" FontSize="12" Margin="0,0,16,0" Checked="Mode_Changed"/>
                    <RadioButton x:Name="rbTemplate" Content="ビューテンプレート" GroupName="Mode"
                                 VerticalAlignment="Center" FontSize="12" Checked="Mode_Changed"/>
                    <TextBlock x:Name="lblModeHint" Text="※ 同名のものを自動で選択します"
                               VerticalAlignment="Center" FontSize="11" Foreground="#777777" Margin="16,0,0,0"/>
                </StackPanel>

                <!-- V/G はオブジェクトスタイルへの差分でしかないため、基準値も揃えないと表示は一致しない -->
                <TextBlock x:Name="lblObjStyleHint" Grid.Row="3" Grid.Column="0" Text="基準値:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,6,8,0"/>
                <CheckBox x:Name="chkObjectStyles" Grid.Row="3" Grid.Column="1" IsChecked="True"
                          Content="オブジェクトスタイル（線の色・太さ・線種）も揃える"
                          FontSize="12" Margin="0,6,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 中段: 左＝移行元データ情報 / 右＝移行先データ情報 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 移行元モデル データ情報 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource SourceLine}" BorderThickness="1"
                    CornerRadius="2" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SourceTint}"
                            BorderBrush="{StaticResource SourceLine}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="lblSourceSection" Text="移行元モデル データ情報"
                                   Foreground="{StaticResource SourceAccent}"
                                   Style="{StaticResource SectionHeader}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.1*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblSrcViewCaption" Grid.Row="0" Text="① 読み取り元のビューを選択"
                                   Style="{StaticResource ListCaption}"/>
                        <TextBlock x:Name="lblSrcViewHint" Grid.Row="1"
                                   Text="※ そのビューで実際に効いている設定を読み取ります（ビューテンプレート由来／ビュー個別のどちらでも）"
                                   Style="{StaticResource HintText}"/>
                        <TextBox x:Name="SrcViewSearch" Grid.Row="2" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="SrcViewSearch_Changed"/>
                        <ListBox x:Name="SrcViewList" Grid.Row="3" FontSize="12"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 DisplayMemberPath="Name" SelectionMode="Single"
                                 SelectionChanged="SrcView_Changed"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"/>

                        <TextBlock x:Name="lblSrcDwgCaption" Grid.Row="4" Text="② このビューにある DWG を選択"
                                   Style="{StaticResource ListCaption}" Margin="0,8,0,3"/>
                        <ListBox x:Name="SrcDwgList" Grid.Row="5" FontSize="12"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 ItemTemplate="{StaticResource DwgItemTemplate}"
                                 HorizontalContentAlignment="Stretch" SelectionMode="Single"
                                 SelectionChanged="SrcDwg_Changed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中央の矢印 -->
            <TextBlock Grid.Column="1" Text="&#x25B6;" FontSize="20" Foreground="#A6AEB5"
                       VerticalAlignment="Center" Margin="10,0"/>

            <!-- 右: 移行先モデル データ情報 -->
            <Border Grid.Column="2" BorderBrush="{StaticResource TargetLine}" BorderThickness="1"
                    CornerRadius="2" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource TargetTint}"
                            BorderBrush="{StaticResource TargetLine}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="lblTargetSection" Text="移行先モデル データ情報"
                                   Foreground="{StaticResource TargetAccent}"
                                   Style="{StaticResource SectionHeader}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.1*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblTgtViewCaption" Grid.Row="0" Text="③ 反映するビューを選択（複数可）"
                                   Style="{StaticResource ListCaption}"/>
                        <TextBox x:Name="TgtViewSearch" Grid.Row="1" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TgtViewSearch_Changed"/>

                        <DataGrid x:Name="TgtViewGrid" Grid.Row="2"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0" RowHeaderWidth="0"
                                  BorderBrush="#DDDDDD" BorderThickness="1" FontSize="12"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="colTgtSelect" Header="" Width="34" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsApplicable}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="colTgtName" Header="名前" Binding="{Binding Name}"
                                                    Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="colTgtStatus" Header="状態" Binding="{Binding StatusText}"
                                                    Width="1.1*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <!-- 補足（テンプレートへ振り替え）は控えめな色、
                                             適用不可の行だけ警告色にする -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Foreground" Value="{StaticResource TargetAccent}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding StatusText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button x:Name="btnTgtSelectAll" Content="全選択"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="TgtSelectAll_Click"/>
                            <Button x:Name="btnTgtDeselectAll" Content="選択解除"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="TgtDeselectAll_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="lblTgtDwgCaption" Grid.Row="4" Text="④ 反映先の DWG を選択（複数可）"
                                   Style="{StaticResource ListCaption}" Margin="0,8,0,3"/>
                        <ListBox x:Name="TgtDwgList" Grid.Row="5" FontSize="12"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 ItemTemplate="{StaticResource DwgCheckItemTemplate}"
                                 HorizontalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 下部: サマリとボタン ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnReload" Grid.Column="0" Content="再読み込み"
                    Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="90"
                    Margin="0" Click="Reload_Click"/>

            <TextBlock x:Name="txtSummary" Grid.Column="1" Text="" FontSize="11" Foreground="#555555"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnApply" Content="設定を移行"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Click="Apply_Click"/>
                <Button x:Name="btnClose" Content="閉じる"
                        Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="90"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
