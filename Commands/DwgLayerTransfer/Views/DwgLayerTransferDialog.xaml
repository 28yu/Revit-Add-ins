<Window x:Class="Tools28.Commands.DwgLayerTransfer.Views.DwgLayerTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWGレイヤ表示設定の移行"
        Width="960"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="RevitBlue" Color="#0066CC"/>
        <SolidColorBrush x:Key="RevitHoverBlue" Color="#0052A3"/>
        <SolidColorBrush x:Key="RevitDarkGray" Color="#333333"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource RevitBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource RevitBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RevitHoverBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RevitHoverBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 説明 -->
        <TextBlock x:Name="txtDescription" Grid.Row="0"
                   Text="開いている別のモデルから、DWG レイヤの表示設定（表示/非表示・線の色・線幅・線種・ハーフトーン）をこのモデルへ移行します。"
                   TextWrapping="Wrap" FontSize="12" Foreground="#333333" Margin="0,0,0,8"/>

        <!-- 移行元モデル・対象モード -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblSource" Grid.Row="0" Grid.Column="0" Text="移行元モデル:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                <ComboBox x:Name="cmbSource" Grid.Row="0" Grid.Column="1" Height="26" FontSize="12"
                          VerticalContentAlignment="Center" Margin="0,0,0,4"
                          SelectionChanged="Source_Changed"/>

                <TextBlock x:Name="lblTarget" Grid.Row="1" Grid.Column="0" Text="移行先モデル:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                <TextBlock x:Name="txtTarget" Grid.Row="1" Grid.Column="1" Text=""
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="#0066CC" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                <TextBlock x:Name="lblMode" Grid.Row="2" Grid.Column="0" Text="移行の単位:"
                           VerticalAlignment="Center" FontSize="12" Margin="0,4,8,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="rbTemplate" Content="ビューテンプレート" GroupName="Mode" IsChecked="True"
                                 VerticalAlignment="Center" FontSize="12" Margin="0,0,16,0" Checked="Mode_Changed"/>
                    <RadioButton x:Name="rbView" Content="ビュー" GroupName="Mode"
                                 VerticalAlignment="Center" FontSize="12" Checked="Mode_Changed"/>
                    <TextBlock x:Name="lblModeHint" Text="※ 同名のもの同士を自動で対応付けます"
                               VerticalAlignment="Center" FontSize="11" Foreground="#777777" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DWG 対応表 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblDwgMap" Grid.Row="0" Text="DWG の対応（名前が違う場合は移行先を選び直してください）"
                       FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>

            <DataGrid x:Name="DwgGrid" Grid.Row="1" MaxHeight="130"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#ECECEC" RowHeaderWidth="0"
                      BorderBrush="#CCCCCC" BorderThickness="1" FontSize="12" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="colDwgSource" Header="移行元 DWG" Binding="{Binding SourceLabel}"
                                        Width="2*" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                    <DataGridTemplateColumn x:Name="colDwgTarget" Header="移行先 DWG" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="12" Margin="2" BorderBrush="#CCCCCC"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="colDwgStatus" Header="レイヤ照合" Binding="{Binding StatusText}"
                                        Width="1.4*" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ビュー対応表 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblViewMap" Grid.Row="0" Text="移行するビューの対応"
                       FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>

            <DataGrid x:Name="ViewGrid" Grid.Row="1"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#ECECEC" RowHeaderWidth="0"
                      BorderBrush="#CCCCCC" BorderThickness="1" FontSize="12" IsReadOnly="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="colViewSelect" Header="選択" Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsApplicable}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="colViewSource" Header="移行元" Binding="{Binding SourceName}"
                                        Width="2.2*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="ToolTip" Value="{Binding SourceName}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="colViewCount" Header="設定数" Binding="{Binding SettingCount}"
                                        Width="Auto" MinWidth="64" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn x:Name="colViewTarget" Header="移行先" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="12" Margin="2" BorderBrush="#CCCCCC"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="colViewStatus" Header="状態" Binding="{Binding StatusText}"
                                        Width="1.8*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="ToolTip" Value="{Binding StatusText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 選択操作・件数 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnSelectWithSettings" Content="設定があるものを選択"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                        ToolTip="DWG レイヤの設定が1件以上あり、移行先が決まっている行を選択します"
                        Click="SelectWithSettings_Click"/>
                <Button x:Name="btnSelectAll" Content="全選択"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Click="SelectAll_Click"/>
                <Button x:Name="btnDeselectAll" Content="選択解除"
                        Style="{StaticResource SecondaryButtonStyle}" Click="DeselectAll_Click"/>
            </StackPanel>
            <TextBlock x:Name="txtCount" Grid.Column="1" Text="" FontSize="11" Foreground="#555555"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ボタン行 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnReload" Grid.Column="0" Content="再読み込み"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Reload_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnApply" Content="設定を移行"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Click="Apply_Click"/>
                <Button x:Name="btnClose" Content="閉じる"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
