<Window x:Class="Tools28.Commands.DuplicateInstance.Views.DeleteProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="削除中"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#333333" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid>
            <ProgressBar x:Name="Bar" Height="22" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="PercentText" Text="0%" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <TextBlock x:Name="CountText" Text="" FontSize="11" Foreground="#555555" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ElapsedText" Text="" FontSize="11" Foreground="#555555" HorizontalAlignment="Right"/>
        </Grid>
        <Button x:Name="btnCancel" Content="中止" HorizontalAlignment="Right" MinWidth="90" Height="28"
                Margin="0,12,0,0" Click="Cancel_Click"/>
    </StackPanel>
</Window>
