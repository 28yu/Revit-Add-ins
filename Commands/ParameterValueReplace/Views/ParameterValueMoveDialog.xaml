<Window x:Class="Tools28.Commands.ParameterValueReplace.Views.ParameterValueMoveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パラメータ値の移動"
        Width="1000"
        Height="640"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="RevitBlue" Color="#0066CC"/>
        <SolidColorBrush x:Key="RevitHoverBlue" Color="#0052A3"/>
        <SolidColorBrush x:Key="RevitDarkGray" Color="#333333"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource RevitBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource RevitBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RevitHoverBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RevitHoverBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A93226"/>
                    <Setter Property="BorderBrush" Value="#A93226"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource RevitDarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 説明 -->
        <TextBlock x:Name="txtDescription" Grid.Row="0" TextWrapping="Wrap" FontSize="12" Foreground="#333333" Margin="0,0,0,8"
                   Text="同じ名前でパラメータグループが違う文字パラメータの間で、値を要素ごとに移動します。"/>

        <!-- 範囲・読み込み -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock x:Name="lblScope" Text="範囲:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbScope" Width="160" Height="24" FontSize="12" Margin="0,0,12,0"/>
            <CheckBox x:Name="chkIncludeTypes" Content="タイプパラメータも対象" IsChecked="True"
                      VerticalAlignment="Center" FontSize="12" Margin="0,0,16,0"/>
            <Button x:Name="btnLoad" Content="パラメータを読み込む" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160"
                    Click="Load_Click"/>
        </WrapPanel>

        <!-- 移動元 → 移動先 -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock x:Name="lblSource" Text="移動元のグループ:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbSource" Width="180" Height="24" FontSize="12" SelectionChanged="Group_Changed"/>
            <TextBlock Text="→" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
            <TextBlock x:Name="lblTarget" Text="移動先のグループ:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbTarget" Width="180" Height="24" FontSize="12" Margin="0,0,20,0" SelectionChanged="Group_Changed"/>
        </WrapPanel>

        <!-- 移動先に値がある場合 -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock x:Name="lblExisting" Text="移動先にすでに違う値がある要素:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
            <RadioButton x:Name="rbKeep" Content="移動先の値を残す（移動しない）" GroupName="Existing" IsChecked="True"
                         VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" Checked="Option_Changed"/>
            <RadioButton x:Name="rbOverwrite" Content="移動元の値で上書きする" GroupName="Existing"
                         VerticalAlignment="Center" FontSize="12" Checked="Option_Changed"/>
        </WrapPanel>

        <!-- パラメータ名ごとの一覧 -->
        <DataGrid x:Name="ResultGrid" Grid.Row="4"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECECEC"
                  RowHeaderWidth="0" IsReadOnly="False" BorderBrush="#CCCCCC" BorderThickness="1" FontSize="12">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="colSelect" Header="移動" Width="46" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="colName" Header="パラメータ名" Binding="{Binding ParameterName}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="colSourceValue" Header="移動元に値あり" Binding="{Binding SourceValueCount}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colTargetElem" Header="移動先を持つ要素" Binding="{Binding TargetElementCount}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colMovable" Header="移動する" Binding="{Binding MovableText}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colNoTarget" Header="移動先なし" Binding="{Binding NoTargetText}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colTargetHas" Header="移動先に値あり" Binding="{Binding TargetHasValueText}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="colConflict" Header="値の食い違い" Binding="{Binding ConflictText}" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 進捗・件数 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnSelectAll" Content="全選択" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,4,0" Click="SelectAll_Click"/>
                <Button x:Name="btnDeselectAll" Content="選択解除" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0" Click="DeselectAll_Click"/>
                <ProgressBar x:Name="Progress" Width="220" Height="16" Minimum="0" Maximum="100"
                             Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtStatus" Text="" FontSize="11" Foreground="#555555"
                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="txtCount" Grid.Column="1" Text="" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
        </Grid>

        <!-- ボタン行 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btnPreview" Content="確認（件数を数える）" Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="150" IsEnabled="False" Click="Preview_Click"/>
            <Button x:Name="btnMove" Content="移動を実行" Style="{StaticResource DangerButtonStyle}"
                    MinWidth="130" IsEnabled="False" Click="Move_Click"/>
            <Button x:Name="btnClose" Content="閉じる" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
